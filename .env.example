# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AgencyOS Architecture Providers (Supabase Production Integration)
VITE_APP_ENV="production"
VITE_AUTH_PROVIDER="supabase"
VITE_DATABASE_PROVIDER="supabase"
VITE_AI_PROVIDER="mock_copilot"
VITE_AUTOMATION_PROVIDER="event_bus_ready"

# Supabase Project Configuration
# Set these in your environment or hosting secrets
VITE_SUPABASE_URL="https://csedlsciyxpdusqblbgv.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_KTG4rJ-kmd7TI_88XJeP_A_yzDycRss"
